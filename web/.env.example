# Environment variables for the FDE Journey web app. Names only: never commit real values.
# Copy to .env.local for local development. On Vercel, set them in the project settings.

# ---- Sign-in (Better Auth) ----
# Random secret, at least 32 characters, that signs session cookies. Generate one with
# `openssl rand -base64 32`. Required wherever the app runs.
BETTER_AUTH_SECRET=
# The app's public address, for example http://localhost:3000 locally or the production URL.
BETTER_AUTH_URL=

# GitHub OAuth app (github.com > Settings > Developer settings > OAuth Apps). Callback URL:
# {BETTER_AUTH_URL}/api/auth/callback/github. Without these, the app runs but nobody can sign in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The owner's numeric GitHub user id (not the login name, which can change). Only this account
# can sign in. Find it at https://api.github.com/users/{login} ("id").
OWNER_GITHUB_ID=

# ---- Database ----
# Neon Postgres connection string (postgresql://...). Required on Vercel. Leave empty locally to
# use the in-process database (PGlite), which needs no server.
DATABASE_URL=
# Optional: folder for the local PGlite database. Default: .data/pglite (gitignored).
PGLITE_DIR=

# ---- End-to-end tests only ----
# Set by playwright.config.ts for the test server. Leave empty everywhere else. With E2E_AUTH=1
# the app refuses to use DATABASE_URL, and the test seed refuses to run on Vercel or against any
# database other than a local PGlite folder under .data/.
E2E_AUTH=
# Random per test run: the test owner's session token and the secret that signs its cookie.
E2E_SESSION_TOKEN=
E2E_AUTH_SECRET=
