# Environment variables for the FDE Journey web app. Names only: never commit real values.
# Copy to .env.local for local development. On Vercel, set them in the project settings.

# ---- Sign-in (Better Auth) ----
# Random secret, at least 32 characters, that signs session cookies. Generate one with
# `openssl rand -base64 32`. Required wherever the app runs.
BETTER_AUTH_SECRET=
# The app's public address, for example http://localhost:3000 locally or the production URL.
BETTER_AUTH_URL=

# GitHub OAuth app (github.com > Settings > Developer settings > OAuth Apps). Callback URL:
# {BETTER_AUTH_URL}/api/auth/callback/github. Without these, the app runs but nobody can sign in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The owner's numeric GitHub user id (not the login name, which can change). Only this account
# can sign in. Find it at https://api.github.com/users/{login} ("id"). `npm run db:import` also
# reads it, to import the tracker records for the owner's user.
OWNER_GITHUB_ID=

# Who may sign in (M4b, lib/signup-mode.ts). Empty (the default) or anything but "capped": only
# OWNER_GITHUB_ID can sign in. "capped": anyone with a GitHub account can sign up; they get a place
# while fewer than the user cap (set on the admin Sign-up page, 100 to start) have one, and join the
# waitlist after that. The owner is never capped. Turn it on only after trying it with a second
# test account. Changing it needs a redeploy.
SIGNUP_MODE=

# ---- Database ----
# Neon Postgres connection string (postgresql://...). Required on Vercel. Leave empty locally to
# use the in-process database (PGlite), which needs no server.
DATABASE_URL=
# Optional: folder for the local PGlite database. Default: .data/pglite (gitignored).
PGLITE_DIR=

# ---- End-to-end tests only ----
# Set by playwright.config.ts for the test server. Leave empty everywhere else. With E2E_AUTH=1
# the app refuses to use DATABASE_URL, and the test seed refuses to run on Vercel or against any
# database other than a local PGlite folder under .data/.
E2E_AUTH=
# Random per test run: the test owner's session token and the secret that signs its cookie.
E2E_SESSION_TOKEN=
E2E_AUTH_SECRET=
# Per test run, comma-separated: more sessions for the test owner, which tests that sign out end
# instead of the shared one (derived from E2E_AUTH_SECRET by tests/e2e/auth.ts).
E2E_SPARE_SESSION_TOKENS=
# Per test run, comma-separated user:token pairs: sessions for the made-up waitlisted, suspended,
# admin and second active users (scripts/lib/e2e-data.mjs), derived like the spare ones.
E2E_USER_SESSION_TOKENS=
# Per test run: the SHA-256 of the made-up active user's Claude export key (the key itself is
# derived from E2E_AUTH_SECRET by tests/e2e/auth.ts and never stored).
E2E_EXPORT_KEY_HASH=
